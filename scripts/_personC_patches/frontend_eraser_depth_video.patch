         with self.get_lock():
             self.__item_setter(index, item)
 
+    def _load_dynamic_mask(self, index, tstamp):
+        """(Person C) Load a precomputed (H/8 x W/8) dynamic mask for a keyframe's source frame.
+        Masks come from scripts/gen_dynamic_masks.py, keyed by dataset frame index."""
+        import os, numpy as np
+        try:
+            idx = int(index.item()) if torch.is_tensor(index) else int(index)
+            fidx = int(float(tstamp.item()) if torch.is_tensor(tstamp) else float(tstamp))
+            path = os.path.join(self.dynamic_mask_dir, f"{fidx}.npy")
+            if os.path.exists(path):
+                m = torch.from_numpy(np.load(path)).to(self.dynamic_mask.device, torch.float)
+                if tuple(m.shape) == tuple(self.dynamic_mask.shape[1:]):
+                    self.dynamic_mask[idx] = m
+        except Exception as e:
+            print('[dynamic_eraser] mask load skip:', e)
+
+    def _apply_dynamic_weight(self, weight, ii):
+        """(Person C) Down-weight dynamic pixels in the per-edge BA confidence so moving
+        objects do not constrain pose/depth. Shape-guarded: no-op if layout doesn't match."""
+        try:
+            m = self.dynamic_mask[ii]                 # (E, h8, w8)
+            keep = (1.0 - m)
+            if weight.dim() == 4 and tuple(weight.shape[1:3]) == tuple(m.shape[1:3]):
+                return weight * keep.unsqueeze(-1)
+            if weight.dim() == 3 and weight.shape[1] == m.shape[1] * m.shape[2]:
+                return weight * keep.reshape(keep.shape[0], -1, 1)
+        except Exception as e:
+            print('[dynamic_eraser] weight masking skip:', e)
+        return weight
+
     def __getitem__(self, index):
         """ index the depth video """
 
